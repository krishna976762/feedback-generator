{
  "name": "feedback-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:dev": "env-cmd -f .env.development vite",
    "start:qa": "env-cmd -f .env.qa vite",
    "start:prod": "env-cmd -f .env.production vite",
    "build": "vite build",
    "build:qa": "env-cmd -f .env.qa vite build",
    "build:prod": "env-cmd -f .env.production vite build",
    "preview": "vite preview",
    "server": "json-server --watch db.json --port 3001"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "html2canvas": "^1.4.1",
    "json-server": "^1.0.0-beta.6",
    "jspdf": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.2",
    "env-cmd": "^11.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0"
  }
}
